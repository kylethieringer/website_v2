---
import Socials from "../components/Socials.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  className="flex h-svh max-w-sm flex-col justify-center"
>
  <main class="space-y-4">
    <p>kyle thieringer (he/him)</p>

    <p>
      i am a grad student at the university of washington in the labs of <a
        href="https://www.ahmedlab.science"
        target="_blank"
        class="font-[575] text-[#41550A] hover:scale-105 hover:text-[#B6A12B] hover:underline dark:text-[#B6A12B] dark:hover:text-[#41550A]"
        >sama ahmed</a
      > and <a
        href="https://faculty.washington.edu/tuthill/"
        target="_blank"
        class="font-[575] text-[#41550A] hover:scale-105 hover:text-[#B6A12B] hover:underline dark:text-[#B6A12B] dark:hover:text-[#41550A]"
        >john tuthill</a
      >.
    </p>
    <p>
      im currently working on a project to understand how flies fly. Flies
      perform various acrobatic maneuvers which require precise timing of motor
      neuron activity on a wingbeat to wingbeat timescale. To study this, I am
      using a combination of connectomics, tethered flight experiments, and in
      vivo whole cell patch clamp electrophysiology.
    </p>

    <Socials />
  </main>
</Layout>
